# =====================================================================
# Variables de entorno para Raco Blanquerna
# Copia este fichero a `.env.local` y rellena tus claves reales.
# `.env.local` está en .gitignore, no se sube al repo.
# =====================================================================

# IA — Anthropic Claude (RECOMENDADO, primer proveedor)
# Crea la clave en https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY="sk-ant-..."

# IA — Google Gemini (fallback / OCR rápido)
# Crea la clave en https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY="AIza..."

# (Legacy — algunas vistas aún usan estas variantes; déjalas iguales que las VITE_*)
GEMINI_API_KEY="AIza..."

# URL pública de la app — usado por OAuth callbacks
APP_URL="https://companyfernandezagnes-hue.github.io/raco"
